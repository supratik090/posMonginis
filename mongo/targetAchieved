db.bills.aggregate([
  {
    $match: {
      date: {
        $gte: new Date("2025-04-01T00:00:00.000Z"),
        $lt: new Date("2025-05-01T00:00:00.000Z")
      }
    }
  },
  {
    $addFields: {
      istDate: {
        $dateAdd: {
          startDate: {
            $dateAdd: {
              startDate: "$date",
              unit: "hour",
              amount: 5
            }
          },
          unit: "minute",
          amount: 30
        }
      }
    }
  },
  {
    $addFields: {
      isMorning: {
        $or: [
          { $lt: [{ $hour: "$istDate" }, 15] },
          {
            $and: [
              { $eq: [{ $hour: "$istDate" }, 15] },
              { $lt: [{ $minute: "$istDate" }, 30] }
            ]
          }
        ]
      }
    }
  },
  {
    $group: {
      _id: {
        date: {
          $dateToString: {
            format: "%Y-%m-%d",
            date: "$istDate"
          }
        }
      },
      morningSales: {
        $sum: {
          $cond: ["$isMorning", "$totalAmount", 0]
        }
      },
      eveningSales: {
        $sum: {
          $cond: [{ $not: ["$isMorning"] }, "$totalAmount", 0]
        }
      },
      totalSales: { $sum: "$totalAmount" },
      billCount: { $sum: 1 }
    }
  },
  {
    $match: {
      $or: [
        { morningSales: { $gt: 4000 } },
        { eveningSales: { $gt: 12000 } }
      ]
    }
  },
  {
    $sort: { "_id.date": 1 }
  }
]);









